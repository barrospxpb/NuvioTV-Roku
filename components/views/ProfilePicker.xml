<?xml version="1.0" encoding="utf-8" ?>
<component name="ProfilePicker" extends="Group">
    <interface>
        <field id="profiles" type="array" onChange="build" />
        <field id="selected" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/Mask.brs" />
    <script type="text/brightscript" uri="pkg:/components/Config.brs" />
    <script type="text/brightscript" uri="pkg:/components/I18n.brs" />
    <script type="text/brightscript" uri="pkg:/components/Util.brs" />
    <script type="text/brightscript" uri="pkg:/components/views/ProfilePicker.brs" />
    <script type="text/brightscript" uri="pkg:/source/bslib.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x0B0C11FF" />
        <Poster width="1920" height="1080" uri="pkg:/images/legacy_original_login_bg.jpg" loadDisplayMode="scaleToFill" opacity="0.17" />
        <Label id="heading" translation="[0,170]" width="1920" height="85" horizAlign="center" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" text="Quem está assistindo?" />
        <Group id="row" translation="[0,422]" />
        <Label id="statusText" translation="[0,792]" width="1920" height="48" horizAlign="center" font="font:SmallSystemFont" color="0xC8CEDAFF" />
        <Label translation="[0,865]" width="1920" height="46" horizAlign="center" font="font:SmallSystemFont" color="0x9BA6B8FF" text="←  →  escolher perfil     •     OK  continuar" />
    </children>
</component>
